# ==============================================================================
# InsightVault: Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your personal API credentials.
# NEVER commit your active '.env' file or private credentials to git.

# ------------------------------------------------------------------------------
# 1. Supabase Database & Vector Storage (Required)
# ------------------------------------------------------------------------------
# Get your project URL and public anon key from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ------------------------------------------------------------------------------
# 2. LLM Inference Provider: Groq (Recommended - Ultra-Fast & Free)
# ------------------------------------------------------------------------------
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 3. Vector Embedding Providers (Multi-Tier Fallback: HF -> Gemini -> OpenAI)
# ------------------------------------------------------------------------------
# Tier 1: Hugging Face Inference API (Requires 'Make calls to Inference Providers' permission)
# Get your token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# Tier 2: Google Gemini (Native 1536-dimensional embedding fallback)
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Tier 3: OpenAI (Optional fallback if paid credits are available)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Optional Security Perimeter Token
# ------------------------------------------------------------------------------
# If set, all /api/* routes require 'Authorization: Bearer <token>' or cookie 'vault_token'
# VAULT_ACCESS_TOKEN=your-random-secure-passphrase-here
